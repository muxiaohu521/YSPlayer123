# ============================================================
# 开源发布 / 云端上传过滤（GitHub、Gitee、GitLab 等平台通用）
# ============================================================

# 构建输出目录
/app/build/
/release/
/output/
/app/release/
/app/debug/

# X5 内核 APK 属于源码必需资源，必须入库（勿被 *.apk 规则过滤）
!/app/src/arm32X5/kernel/*.apk
!/app/src/arm64X5/kernel/*.apk

# AAR 手工解包残留目录（Gradle 直接读取 .aar，解包内容无需入库）
/local-maven/**/extracted/

# 构建缓存与中间产物
*.bak
*.orig
*.rej
*.tmp
*.swp
*.prof
*.profm
baseline-prof.txt
mapping.txt
seeds.txt
usage.txt

# 签名与密钥（严禁上传）
keystore.properties
signing.properties
*.p12
*.pem
*.bks

# 自动下载的构建工具链（体积巨大，由构建脚本自动获取）
/jdk/
/sdk/
/android-sdk/
/android-ndk/

# Python 脚本缓存与本地构建状态
__pycache__/
*.py[cod]
*.pyo
scripts/.build_cache.json

# 编辑器 / 终端配置
.vscode/
.trae/
.claude/
.cursor/

# 本地临时与备份
temp/
tmp/
*.zip
*.7z
*.rar

# 忽略所有可执行文件与安装包（仅保留源码）
*.exe
*.msi
*.dmg