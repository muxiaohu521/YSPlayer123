<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/engineContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/clickOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <View
            android:id="@+id/clickOverlayLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/clickOverlayRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/leftChannelPanel"
        android:layout_width="@dimen/channel_panel_width"
        android:layout_height="match_parent"
        android:background="@drawable/bg_list"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/panel_header_height"
            android:gravity="center"
            android:text="频道列表"
            android:textColor="@color/color_1890FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannelList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rightSettingsPanel"
        android:layout_width="@dimen/settings_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@drawable/bg_list"
        android:orientation="horizontal"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSettingItems"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="true"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <View
            android:id="@+id/vSettingDivider"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSettingTabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="120dp"
            android:focusable="true"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingEnd="4dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomInfoBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCurrentChannel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/white"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvPanelHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="←频道 | →设置"
            android:textColor="@color/color_1890FF"
            android:textSize="16sp"
            android:gravity="end" />
    </LinearLayout>
</FrameLayout>