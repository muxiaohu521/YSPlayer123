{
    "manifest_version": 2,
    "name": "ysplayer_fullscreen",
    "version": "1.0",
    "description": "Force video fullscreen and unmute",

    "applications": {
        "gecko": {
            "id": "ysplayer@com.ysplayer"
        }
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "css": ["style.css"],
            "run_at": "document_end",
            "all_frames": true
        }
    ],

    "permissions": []
}